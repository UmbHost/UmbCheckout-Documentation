---
import PrintButton from './PrintButton.astro';
import ShareLinks from './ShareLinks.astro';

interface Props {
	url: string;
	title: string;
}
const { url, title } = Astro.props;
---

<div class="art-toolbar print:hidden" role="toolbar" aria-label="Article actions">
	<ShareLinks url={url} title={title} />
	<PrintButton />
</div>

<style is:global>
	.art-toolbar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin: 0 0 1.25rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px dashed color-mix(in srgb, var(--sl-color-gray-5, #555) 50%, transparent);
	}
	.art-share {
		display: inline-flex;
		gap: 0.25rem;
	}
	.art-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.65rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-gray-5, #555) 50%, transparent);
		border-radius: 4px;
		background: transparent;
		color: var(--sl-color-text, currentColor);
		font: inherit;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}
	.art-btn:hover,
	.art-btn:focus-visible {
		background: color-mix(in srgb, var(--sl-color-text, #fff) 6%, transparent);
		border-color: color-mix(in srgb, var(--sl-color-text, #fff) 35%, transparent);
		outline: none;
	}
	.art-btn--icon {
		padding: 0.4rem;
	}
	.art-btn svg {
		width: 1rem;
		height: 1rem;
		display: block;
	}
	.art-btn--icon svg { width: 1.05rem; height: 1.05rem; }

	/* Brand-tinted hover for share targets */
	.art-share__facebook:hover  { color: #1877f2; border-color: currentColor; }
	.art-share__linkedin:hover  { color: #0a66c2; border-color: currentColor; }
	.art-share__bluesky:hover   { color: #1185fe; border-color: currentColor; }
	.art-share__mastodon:hover  { color: #6364ff; border-color: currentColor; }
	.art-share__email:hover     { color: var(--sl-color-text-accent, #e96e2d); border-color: currentColor; }

	@media (max-width: 36rem) {
		.art-toolbar { justify-content: flex-start; }
		.art-btn span { display: none; }
		.art-btn { padding: 0.4rem; }
	}
</style>
